<odoo>
    <data noupdate="1">
        <record id="documents_folder_projects" model="documents.document">
            <field name="name">Projekty</field>
            <field name="type">folder</field>
            <field name="owner_id" eval="False"/>
            <field name="company_id" eval="False"/>
            <field name="access_internal">none</field>
            <field name="access_via_link">none</field>
            <field name="is_access_via_link_hidden" eval="True"/>
        </record>

        <record id="ir_cron_sharepoint_project_document_access" model="ir.cron">
            <field name="name">SharePoint: priečinky a prístupy k dokumentom projektov</field>
            <field name="model_id" ref="tenenet_projects.model_tenenet_project"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_project_document_access()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
