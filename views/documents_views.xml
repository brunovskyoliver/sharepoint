<odoo>
    <record id="documents.document_action_preference" model="ir.actions.client">
        <field name="context">{'documents_init_folder_id': 'COMPANY'}</field>
    </record>

    <record id="documents.document_action" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,activity</field>
        <field name="mobile_view_mode">list</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('documents.documents_view_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('documents.document_view_kanban')}),
            (0, 0, {'view_mode': 'activity', 'view_id': ref('documents.documents_view_activity')})]"/>
    </record>
</odoo>
