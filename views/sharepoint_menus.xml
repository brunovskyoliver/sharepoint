<odoo>
    <!-- One Dokumenty application: documents remain the default workspace and
         Knowledge is exposed through its navigation instead of a second tile. -->
    <record id="documents.menu_root" model="ir.ui.menu">
        <field name="name">Dokumenty</field>
    </record>

    <record id="documents.dashboard" model="ir.ui.menu">
        <field name="name">Dokumenty</field>
        <field name="sequence">20</field>
    </record>

    <menuitem id="menu_sharepoint_teams"
              name="Tímy"
              parent="documents.menu_root"
              action="sharepoint.action_sharepoint_team_hub"
              sequence="10"/>

    <record id="knowledge.knowledge_menu_root" model="ir.ui.menu">
        <field name="active">False</field>
    </record>

    <record id="knowledge.knowledge_menu_home" model="ir.ui.menu">
        <field name="active">False</field>
    </record>

    <record id="knowledge.knowledge_menu_article" model="ir.ui.menu">
        <field name="name">Články</field>
        <field name="parent_id" ref="documents.menu_root"/>
        <field name="action" ref="knowledge.ir_actions_server_knowledge_home_page"/>
        <field name="sequence">30</field>
    </record>

    <record id="documents.Config" model="ir.ui.menu">
        <field name="name">Konfigurácia</field>
        <field name="sequence">40</field>
    </record>

    <record id="knowledge.knowledge_menu_configuration" model="ir.ui.menu">
        <field name="active">False</field>
    </record>

    <record id="knowledge.knowledge_article_member_menu" model="ir.ui.menu">
        <field name="parent_id" ref="documents.Config"/>
    </record>

    <record id="knowledge.knowledge_article_favorite_menu" model="ir.ui.menu">
        <field name="parent_id" ref="documents.Config"/>
    </record>

    <record id="knowledge.knowledge_article_menu_trashed" model="ir.ui.menu">
        <field name="parent_id" ref="documents.Config"/>
    </record>

    <record id="knowledge.knowledge_article_stage_menu" model="ir.ui.menu">
        <field name="parent_id" ref="documents.Config"/>
    </record>
</odoo>
