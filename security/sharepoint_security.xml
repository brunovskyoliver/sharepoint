<odoo>
    <record id="res_groups_privilege_sharepoint" model="res.groups.privilege">
        <field name="name">SharePoint</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_sharepoint_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="sharepoint.res_groups_privilege_sharepoint"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_sharepoint_team_manager_all" model="ir.rule">
        <field name="name">SharePoint teams: managers manage all</field>
        <field name="model_id" ref="model_sharepoint_team"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sharepoint.group_sharepoint_manager'))]"/>
    </record>

    <record id="rule_sharepoint_team_user_read" model="ir.rule">
        <field name="name">SharePoint teams: members read active teams</field>
        <field name="model_id" ref="model_sharepoint_team"/>
        <field name="domain_force">[('active', '=', True), ('accessible_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sharepoint_team_owner_write" model="ir.rule">
        <field name="name">SharePoint teams: owners edit teams</field>
        <field name="model_id" ref="model_sharepoint_team"/>
        <field name="domain_force">[('active', '=', True), ('owner_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sharepoint_team_member_manager_all" model="ir.rule">
        <field name="name">SharePoint team members: managers manage all</field>
        <field name="model_id" ref="model_sharepoint_team_member"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sharepoint.group_sharepoint_manager'))]"/>
    </record>

    <record id="rule_sharepoint_team_member_user_read" model="ir.rule">
        <field name="name">SharePoint team members: users read own teams</field>
        <field name="model_id" ref="model_sharepoint_team_member"/>
        <field name="domain_force">[('team_id.active', '=', True), ('team_id.accessible_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sharepoint_team_member_owner_write" model="ir.rule">
        <field name="name">SharePoint team members: owners manage membership</field>
        <field name="model_id" ref="model_sharepoint_team_member"/>
        <field name="domain_force">[('team_id.active', '=', True), ('team_id.owner_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
    </record>

    <record id="rule_sharepoint_team_admin_write" model="ir.rule">
        <field name="name">SharePoint teams: admins edit teams</field>
        <field name="model_id" ref="model_sharepoint_team"/>
        <field name="domain_force">[('active', '=', True), ('admin_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sharepoint_team_member_admin_write" model="ir.rule">
        <field name="name">SharePoint team members: admins manage users and visitors</field>
        <field name="model_id" ref="model_sharepoint_team_member"/>
        <field name="domain_force">[('team_id.active', '=', True), ('team_id.admin_user_ids', 'in', [user.id]), ('role', 'in', ['member', 'visitor'])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
</odoo>
